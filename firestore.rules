rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in ["truongnq.vie@gmail.com", "buiyen.701@gmail.com"];
    }
    // Guest mode cấp identity ẩn danh cho MỌI khách vãng lai, nên
    // isSignedIn() một mình không còn là rào chắn. isPermanent() phân biệt
    // tài khoản thật (Google) với tài khoản ẩn danh.
    function isPermanent() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ─── Per-user documents: users / progress / pets ─────────────────────
    // Đọc chéo (leaderboard/analytics) chỉ dành cho tài khoản thật hoặc
    // admin — khách ẩn danh KHÔNG được liệt kê dữ liệu của người khác,
    // chỉ đọc/ghi doc của chính mình. Ghi: chỉ chính chủ tạo/sửa doc của
    // mình; admin được sửa users để kiểm duyệt; không ai được xoá.
    match /users/{uid} {
      allow read:   if isOwner(uid) || isPermanent() || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if false;
    }

    match /progress/{uid} {
      allow read:   if isOwner(uid) || isPermanent() || isAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // Pet chỉ được chính chủ đọc trong app — không cần đọc chéo.
    match /pets/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // ─── Admin-managed content: exams / sgk ─────────────────────────────
    // Mọi user đã đăng nhập (kể cả khách ẩn danh) đọc được — nội dung học
    // là tính năng guest mode. Chỉ admin được ghi (upload/sửa qua /admin).
    match /exams/{grade}/tests/{examId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    match /sgk/{grade}/units/{unitId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Video lessons: cô giáo tạo bài từ URL YouTube; học sinh đọc để luyện thuộc.
    match /video_lessons/{lessonId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Tiến độ học thuộc video theo từng học sinh.
    match /video_lesson_progress/{uid}/lessons/{lessonId} {
      allow get, list: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // ─── AI grading attempts: speaking / writing ─────────────────────────
    // Owner creates + reads their own; admin reads all for review.
    // Nobody updates/deletes — attempts are append-only history.
    match /speaking_attempts/{uid}/items/{attemptId} {
      allow get, list: if isOwner(uid) || isAdmin();
      allow create:    if isOwner(uid);
      allow update, delete: if false;
    }
    match /writing_attempts/{uid}/items/{attemptId} {
      allow get, list: if isOwner(uid) || isAdmin();
      allow create:    if isOwner(uid);
      allow update, delete: if false;
    }

    // Exam submissions are immutable student snapshots. Only the owner and
    // the existing teacher accounts can read them; teachers review separately.
    match /exam_submissions/{submissionId} {
      allow get: if isSignedIn() && (!exists(/databases/$(database)/documents/exam_submissions/$(submissionId)) || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      function validSnapshot() {
        return request.auth != null
        && request.resource.data.keys().hasOnly(['version', 'uid', 'studentName', 'className', 'grade', 'examId', 'examTitle', 'mode', 'startedAt', 'finishedAt', 'receivedAt', 'correct', 'total', 'manual', 'score', 'questions', 'state', 'revision', 'answered'])
        && request.resource.data.version == 1
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 2 && request.resource.data.studentName.size() <= 100
        && request.resource.data.className is string
        && request.resource.data.className.size() >= 1 && request.resource.data.className.size() <= 60
        && request.resource.data.grade in [6, 7, 8, 9, 10]
        && request.resource.data.examId is string && request.resource.data.examId.size() <= 100
        && request.resource.data.examTitle is string && request.resource.data.examTitle.size() <= 1000
        && request.resource.data.mode in ['practice', 'test']
        && request.resource.data.startedAt is number && request.resource.data.startedAt > 0
        && request.resource.data.finishedAt is number && request.resource.data.finishedAt >= request.resource.data.startedAt
        && request.resource.data.receivedAt == request.time
        && request.resource.data.questions is list && request.resource.data.questions.size() > 0 && request.resource.data.questions.size() <= 200
        && request.resource.data.total is int && request.resource.data.total >= 0
        && request.resource.data.manual is int && request.resource.data.manual >= 0
        && request.resource.data.total + request.resource.data.manual == request.resource.data.questions.size()
        && request.resource.data.correct is int && request.resource.data.correct >= 0 && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 10
        && request.resource.data.get('state', 'submitted') in ['in_progress', 'submitted']
        && (!request.resource.data.keys().hasAny(['state']) || (
          request.resource.data.revision is int && request.resource.data.revision > 0
          && request.resource.data.answered is int && request.resource.data.answered >= 0
          && request.resource.data.answered <= request.resource.data.questions.size()
        ));
      }
      allow create: if validSnapshot();
      // A draft may advance, then becomes immutable when submitted. A delayed
      // draft write cannot undo a newer revision or re-open a submitted paper.
      allow update: if validSnapshot() && isOwner(resource.data.uid)
        && resource.data.get('state', 'submitted') == 'in_progress'
        && request.resource.data.revision > resource.data.revision
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.studentName == resource.data.studentName
        && request.resource.data.className == resource.data.className
        && request.resource.data.grade == resource.data.grade
        && request.resource.data.examId == resource.data.examId
        && request.resource.data.examTitle == resource.data.examTitle
        && request.resource.data.startedAt == resource.data.startedAt;
      allow delete: if false;
      match /reviews/{reviewId} {
        allow read: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/exam_submissions/$(submissionId)).data.uid == request.auth.uid);
        allow create, update: if isAdmin() && reviewId == 'teacher'
          && exists(/databases/$(database)/documents/exam_submissions/$(submissionId))
          && get(/databases/$(database)/documents/exam_submissions/$(submissionId)).data.get('state', 'submitted') == 'submitted'
          && request.resource.data.keys().hasOnly(['comment', 'writingScore', 'reviewedBy', 'updatedAt'])
          && request.resource.data.comment is string && request.resource.data.comment.size() <= 5000
          && (request.resource.data.writingScore == null || (request.resource.data.writingScore is number && request.resource.data.writingScore >= 0 && request.resource.data.writingScore <= 10))
          && request.resource.data.reviewedBy == request.auth.token.email
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    // Public score projection only. A matching finalized private snapshot must
    // exist (or finalize in this same transaction); client fields cannot diverge.
    match /exam_leaderboard/{submissionId} {
      allow read: if true;
      function matchesFinalSnapshot() {
        let source = getAfter(/databases/$(database)/documents/exam_submissions/$(submissionId)).data;
        let target = request.resource.data;
        return isSignedIn() && (source.uid == request.auth.uid || isAdmin())
          && source.get('state', 'submitted') == 'submitted' && source.total > 0
          && target.keys().hasAll(['version', 'studentName', 'className', 'grade', 'examId', 'examTitle', 'mode', 'score', 'finishedAt'])
          && target.keys().hasOnly(['version', 'studentName', 'className', 'grade', 'examId', 'examTitle', 'mode', 'score', 'finishedAt'])
          && target.version == 1 && target.studentName == source.studentName
          && target.className == source.className && target.grade == source.grade
          && target.examId == source.examId && target.examTitle == source.examTitle
          && target.mode == source.mode && target.score == source.score
          && target.finishedAt == source.finishedAt;
      }
      allow create, update: if matchesFinalSnapshot();
      allow delete: if false;
    }

    // ─── Deny everything else by default ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
